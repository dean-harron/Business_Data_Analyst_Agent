# LLM provider: openrouter or huggingface
LLM_PROVIDER=openrouter

# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=Faux Data Analyst Agent

# Hugging Face alternative
HF_TOKEN=
HF_MODEL=

# RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=./workspace/chroma
RAG_COLLECTION=analyst_knowledge

# App
WORKSPACE_DIR=./workspace
OUTPUT_DIR=./outputs
MAX_AGENT_STEPS=30
TOOL_TIMEOUT_SECONDS=120

# YouTube public API
YOUTUBE_API_KEY=

# Email SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_USE_TLS=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=
WHATSAPP_PUBLIC_MEDIA_URL=
